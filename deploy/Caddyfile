# Caddy en el VPS: HTTPS automático con Let's Encrypt, la portada de IKYNDO, la web de la app y /api hacia el
# servidor. DOMAIN y ACME_EMAIL salen del .env de la raíz (ver DESPLIEGUE.md):
#   DOMAIN          → la portada (deploy/landing/)
#   www.DOMAIN      → redirige a la portada
#   app.DOMAIN      → la app y, en /api, el servidor
{
	email {$ACME_EMAIL}
	# Sin interfaz de administración: la configuración solo cambia reconstruyendo la imagen.
	admin off
	servers {
		# Quien manda una petición a cuentagotas para ocupar conexiones se queda fuera.
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
}

# La portada: solo HTML, CSS y el logo, sin JavaScript. Va en otro origen que la app: no comparte nada con los
# datos que la app guarda en el navegador.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# Nada de scripts: solo imágenes y estilos de este mismo dominio.
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		# Versión de prueba: fuera de los buscadores.
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-cache"
		-Server
	}

	# «Entrar en la app» (y quien escriba tudominio.com/app): a la app, en su subdominio.
	@app path /app /app/*
	redir @app https://app.{$DOMAIN}/

	handle {
		root * /srv/landing
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}

	log {
		output stdout
		format console
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# La app (web) y el servidor en /api.
app.{$DOMAIN} {
	encode zstd gzip

	header {
		# Solo HTTPS durante un año (Caddy ya redirige de http a https).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		# Aislamiento entre orígenes: lo necesita SQLite en el navegador (SharedArrayBuffer).
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		# Solo código, estilos y conexiones de este mismo dominio. 'wasm-unsafe-eval' es para SQLite (WebAssembly).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Versión de prueba: fuera de los buscadores.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# El servidor de la app: /api/health → api:3000/health. Solo se llega a él por aquí.
	handle_path /api/* {
		request_body {
			max_size 9MB
		}
		reverse_proxy api:3000 {
			# Las conexiones con el servidor se sueltan antes de que él las cierre (65 s): sin errores 502 sueltos.
			transport http {
				keepalive 30s
			}
		}
	}

	# La web: una sola página, así que cualquier ruta que no sea un archivo carga index.html.
	handle {
		root * /srv/app
		@static path /_expo/static/* /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@page not path /_expo/static/* /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		# Las versiones ya comprimidas al construir la imagen (Brotli o gzip, la que acepte el navegador).
		file_server {
			precompressed br gzip
		}
	}

	log {
		output stdout
		format console
	}
}
