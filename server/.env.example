# Copia este archivo como .env y rellena lo que tengas. .env no se sube a GitHub.
# (En el VPS no hace falta: allí todo va en el .env de la raíz del repositorio, ver DESPLIEGUE.md.)

# Clave de la API de Anthropic (https://console.anthropic.com). Solo vive aquí, nunca en la app.
# Sin ella funcionan los códigos de barras, pero no el análisis de fotos y textos.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: low, medium, high, xhigh o max. Vacío = el del modelo. Menos esfuerzo responde antes.
ANTHROPIC_EFFORT=

# Códigos de acceso de quienes prueban la app: nombre:código, separados por comas.
# Genera cada uno con `npm run new-code -- nombre`. Cada persona pone su código en la app (Más → Servidor).
# Vacío = sin comprobación (solo en desarrollo; en producción el servidor no arranca sin códigos).
ACCESS_CODES=

# Cupo de análisis con IA al día (0 = sin límite). Pone techo al gasto en Anthropic.
DAILY_LIMIT_PER_PERSON=40
DAILY_LIMIT_TOTAL=300
# Peticiones por minuto y dirección IP, y análisis a la vez.
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_ANALYSES=4
MAX_CONCURRENT_PER_PERSON=2
# Códigos incorrectos desde una misma dirección antes de bloquearla 10 minutos (0 = sin bloqueo).
MAX_AUTH_FAILURES=10

# Clave gratuita de USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup
# Vacía = DEMO_KEY, con un límite muy bajo (solo sirve para probar).
USDA_API_KEY=

PORT=3000
# Solo detrás de un proxy (Caddy, Nginx): cuántos saltos hay. Vacío en local.
TRUST_PROXY=
# Orígenes web que pueden llamar desde otro dominio, separados por comas. Vacío = en desarrollo cualquiera,
# en producción ninguno (la web y el servidor van por el mismo dominio).
ALLOWED_ORIGINS=
