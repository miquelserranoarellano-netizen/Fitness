# Configuración del VPS. Copia este archivo como .env (en la raíz del repositorio, en el VPS) y rellénalo.
# .env no se sube a GitHub. Protégelo: chmod 600 .env

# Tu dominio, sin www ni https, y correo para Let's Encrypt. En el DNS, el registro A de «@» con la IP del VPS:
# la presentación y la app quedan juntas en tudominio.com (DESPLIEGUE.md, paso 1).
DOMAIN=tudominio.com
ACME_EMAIL=tu-correo@ejemplo.com

# Clave de Anthropic: DÉJALA VACÍA. La IA va apagada (la app no la enseña) y sin clave el servidor no puede
# llamar a Anthropic: no se gasta ni un token. Solo para encenderla más adelante, junto con EXPO_PUBLIC_AI=on en
# deploy/web.Dockerfile, y con un límite de gasto mensual puesto en https://console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: low, medium, high, xhigh o max. Vacío = el del modelo.
ANTHROPIC_EFFORT=

# Códigos de acceso: nombre:código, separados por comas, sin espacios. Genera cada uno en el VPS con:
#   echo "miquel:$(openssl rand -base64 18 | tr '+/' '-_')"
# (o `npm run new-code -- miquel` dentro de server/). A cada persona le pasas solo la parte de después de «:».
# Ejemplo: ACCESS_CODES=miquel:Xk3...,marc:p9Q...
ACCESS_CODES=

# Cupo de análisis con IA al día (0 = sin límite): techo de gasto.
DAILY_LIMIT_PER_PERSON=40
DAILY_LIMIT_TOTAL=300
RATE_LIMIT_PER_MINUTE=20
# Análisis a la vez, en total y por persona.
MAX_CONCURRENT_ANALYSES=4
MAX_CONCURRENT_PER_PERSON=2
# Códigos incorrectos desde una misma dirección antes de bloquearla 10 minutos (0 = sin bloqueo).
MAX_AUTH_FAILURES=10

# Clave gratuita de USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
