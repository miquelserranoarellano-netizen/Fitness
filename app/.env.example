# Copia este archivo como .env si necesitas cambiar algo. .env no se sube a GitHub.
# Expo mete estas variables dentro de la app: aquí nunca va la clave de Anthropic (esa va en server/.env).

# Dirección del servidor (carpeta server/). Vacía = en desarrollo, el mismo ordenador que sirve la app,
# puerto 3000. Hace falta ponerla en una versión instalada (TestFlight, APK).
# Ejemplos: EXPO_PUBLIC_API_URL=http://192.168.1.20:3000  ·  EXPO_PUBLIC_API_URL=https://tudominio.com/api
# La web del VPS se compila con /api (mismo dominio): lo pone el Dockerfile, no hace falta tocarlo aquí.
EXPO_PUBLIC_API_URL=

# Aquí no va ningún código ni clave: todo lo que empieza por EXPO_PUBLIC_ lo puede leer cualquiera que
# tenga la app. El código de acceso de cada persona se escribe en la app (Más → Servidor).
