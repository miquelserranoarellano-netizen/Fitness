# Copia este archivo como .env si necesitas cambiar algo. .env no se sube a GitHub.
# Expo mete estas variables dentro de la app: aquí nunca va la clave de Anthropic (esa va en server/.env).

# Dirección del servidor (carpeta server/). Vacía = en desarrollo, el mismo ordenador que sirve la app,
# puerto 3000. Hace falta ponerla si usas `npm run tunnel` o en una versión instalada (APK).
# Ejemplo: EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=

# El mismo valor que APP_TOKEN en server/.env (vacío si el servidor no lo pide).
EXPO_PUBLIC_APP_TOKEN=
